# Copy to .env for local development. In production set these as real environment variables.

# --- Web process ---
PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# --- Secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SECRET_KEY=change-me-to-a-long-random-string
# Set true when served over HTTPS so cookies are Secure.
COOKIE_SECURE=false
# Session lifetimes: player (per room) and account cookies.
PLAYER_TOKEN_TTL_SECONDS=172800
ACCOUNT_TOKEN_TTL_SECONDS=2592000

# --- Backing services ---
REDIS_URL=redis://localhost:6379/0
# Leave empty to run without host accounts (guest-only). docker-compose sets this for you.
DATABASE_URL=postgresql+asyncpg://storyfeta:storyfeta@localhost:5432/storyfeta

# --- Game defaults and limits ---
DEFAULT_ROUNDS=5
DEFAULT_TURN_SECONDS=60
MAX_PLAYERS=12
MAX_LINE_LENGTH=280
# Comma-separated emoji offered as reactions.
ALLOWED_REACTIONS=🔥

# --- Rooms and housekeeping ---
ROOM_CODE_LENGTH=4
ROOM_TTL_SECONDS=86400
ROOM_IDLE_SECONDS=21600
CLEANUP_INTERVAL_SECONDS=300
TIMER_POLL_SECONDS=0.5
SHUTDOWN_TIMEOUT_SECONDS=10
